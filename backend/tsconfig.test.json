{
  // Test tipi denetimi için. Yalnızca `--noEmit` ile kullanılır; hiçbir
  // şey üretmez, bu yüzden `rootDir` kısıtına ihtiyaç duymaz.
  //
  // Ayrı bir dosya olmasının sebebi: derleme tsconfig'i `rootDir: ./src`
  // gerektirir ve `test/` bunun dışındadır. İkisini tek dosyada birleştirmek
  // ya testleri tip denetiminden çıkarır ya da derleme çıktısını bozar.
  "extends": "./tsconfig.json",

  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node", "vitest/globals"]
  },

  // `scripts/` de dahildir: demo sunucusu üretim derlemesine girmez ama
  // gerçek servisleri (CryptoService, DlpService, sanitize) import eder.
  // Tip denetimi dışında bırakılırsa, bu servislerin imzası değiştiğinde
  // demo sessizce bozulur ve ancak çalıştırınca fark edilir.
  "include": ["src/**/*", "test/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist"]
}
