# =============================================================================
#  iNCompany — Ortam Yapılandırması
#
#  Kurulum:
#    cp .env.example .env
#  ardından aşağıdaki üretim komutlarıyla sırları doldurun.
#
#  ⚠ .env DOSYASINI ASLA COMMIT ETMEYİN. .gitignore'da olduğunu doğrulayın.
#  ⚠ Üretimde bu dosya KULLANILMAZ — sırlar Vault / AWS Secrets Manager /
#    Kubernetes Secret üzerinden gelir ve dosya sistemine (tmpfs) yazılır.
#    Ortam değişkeni olarak geçirmek bile risklidir: /proc/<pid>/environ
#    üzerinden okunabilir ve çökme dökümlerine düşer.
# =============================================================================

# --- Genel -------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
PUBLIC_URL=http://localhost:3000

# --- Veritabanı --------------------------------------------------------------
POSTGRES_PASSWORD=degistir_guclu_bir_parola
DATABASE_URL=postgresql://incompany:degistir_guclu_bir_parola@localhost:5432/incompany
DB_POOL_MAX=20

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=degistir_guclu_bir_parola
REDIS_URL=redis://:degistir_guclu_bir_parola@localhost:6379

# --- JWT ---------------------------------------------------------------------
#
# ⚠ İKİ SIR FARKLI OLMALIDIR.
#   Aynı sır kullanılırsa bir refresh token, erişim token'ı olarak kabul
#   edilebilir hale gelir (tip karıştırma saldırısı). Uygulama başlangıçta
#   bu ikisinin eşit olup olmadığını kontrol eder ve eşitse BAŞLAMAZ.
#
# Üretmek için (her biri için AYRI AYRI çalıştırın):
#   openssl rand -base64 48
#
JWT_ACCESS_SECRET=degistir_openssl_rand_base64_48_ciktisi_ile
JWT_REFRESH_SECRET=degistir_FARKLI_openssl_rand_base64_48_ciktisi_ile
JWT_ISSUER=https://incompany.local
JWT_AUDIENCE=incompany-web

# --- Şifreleme / KMS ---------------------------------------------------------
#
# 'local'  → YALNIZCA GELİŞTİRME. Uygulama NODE_ENV=production altında
#            bu sağlayıcıyla başlamayı REDDEDER.
# 'aws'    → Üretim. Sarma/açma işlemi KMS içinde olur; master anahtar
#            uygulama sürecinin belleğine hiç inmez.
#
KMS_PROVIDER=local

# Üretmek için: openssl rand -base64 32   (tam 32 bayt olmalıdır)
LOCAL_MASTER_KEY=degistir_openssl_rand_base64_32_ciktisi_ile

# KMS_PROVIDER=aws iken zorunlu:
# AWS_REGION=eu-central-1
# AWS_KMS_KEY_ID=arn:aws:kms:eu-central-1:123456789012:key/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#
# IAM politikası ASGARİ olmalıdır: yalnızca kms:Encrypt ve kms:Decrypt.
# kms:ScheduleKeyDeletion uygulama rolünde ASLA bulunmamalıdır — ele
# geçirilmiş bir uygulama tüm veriyi kalıcı olarak imha edebilir hale gelir.

# --- Dosya Depolama ----------------------------------------------------------
MINIO_ROOT_USER=incompany
MINIO_ROOT_PASSWORD=degistir_guclu_bir_parola
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=incompany-files
S3_ACCESS_KEY=incompany
S3_SECRET_KEY=degistir_guclu_bir_parola

# --- CORS --------------------------------------------------------------------
#
# Virgülle ayrılmış TAM origin listesi. Joker karakter DESTEKLENMEZ.
# Üretimde boş bırakılırsa uygulama başlamaz — yanlış yapılandırmayla
# yayına çıkmaktansa hiç başlamamak tercih edilir.
#
CORS_ORIGINS=http://localhost:5173
WS_PUBLIC_URL=ws://localhost:3000

# --- Frontend (Vite) ---------------------------------------------------------
#
# ⚠ VITE_ ÖNEKLİ HER DEĞER TARAYICI PAKETİNE GÖMÜLÜR VE HERKESE AÇIKTIR.
#   Buraya asla sır koymayın.
#
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000

# --- SSO (opsiyonel, geliştirmede kapalı) ------------------------------------
#
# İstemci sırrı organizasyon bazlıdır ve organizasyon UUID'sinin ilk 8
# karakteriyle adlandırılır (bkz. sso.service.ts → parseConfig).
# Diğer OIDC ayarları (issuer, clientId, endpoint'ler) veritabanındaki
# organizations.sso_config sütunundadır — sır değildirler.
#
# SSO_CLIENT_SECRET_a1b2c3d4=idp_tarafindan_verilen_client_secret
